<?xml version="1.0" encoding="utf-8"?>
<!--
  FLOW mark "E — bars becoming water", on the adaptive-icon canvas.

  The design's 100-unit artwork is scaled to 0.48 and offset so the drawn
  content (x 8..100.5, y 12..92) centres inside the 108dp canvas.

  Why 0.48 and not the 72dp safe zone. A circular mask — the Pixel default —
  inscribes a 66dp circle in that 72dp square, so the usable radius from centre
  is 33dp. This mark is 92.5 units wide against 80 tall, and it is the corners
  of that box that reach furthest:

      scale 0.78 -> 72.2 x 62.4dp, corner reach 47.7dp   ran off the disc
      scale 0.60 -> 55.5 x 48.0dp, corner reach 36.7dp   still clipped
      scale 0.48 -> 44.4 x 38.4dp, corner reach 29.4dp   ~3.6dp clear all round

  Each bar is a round-capped line rather than a rounded rect: with the corner
  radius at half the width the shapes are identical, and this keeps the mark to
  four paths so the monochrome themed-icon layer stays legible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.48"
        android:scaleY="0.48"
        android:translateX="27.96"
        android:translateY="29.04">

        <!-- Three measured bars. -->
        <path
            android:pathData="M13,37 L13,67"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <path
            android:pathData="M29,25 L29,79"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round" />
        <path
            android:pathData="M45,17 L45,87"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round" />

        <!-- Dissolving into the current. -->
        <path
            android:pathData="M56,52 C66,34 74,70 96,54"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
