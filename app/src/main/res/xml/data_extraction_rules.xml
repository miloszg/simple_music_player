<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy as backup_rules.xml, for both cloud and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="plainly-music.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="plainly-music.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
